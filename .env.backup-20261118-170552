# This is the ONE .env file for the whole project — copy it to .env at the
# repo root (not inside backend/). It's read by both docker-compose (for
# db/redis/timescaledb) and by the backend itself when run directly via
# `uvicorn`/`alembic`/scripts (app/core/config.py resolves an absolute path
# to this file, so it works no matter which directory you run commands
# from). There used to be a second, inconsistent backend/.env.example —
# that's been removed; this file is now the only one that matters.
#
# ─── Core ────────────────────────────────────────────────────────────────
SECRET_KEY=changeme_use_32_random_bytes
ENVIRONMENT=development

# ─── Database ────────────────────────────────────────────────────────────
# These use localhost + the HOST-exposed ports from docker-compose.yml,
# because the documented workflow runs `db`/`redis`/`timescaledb` in Docker
# but runs the backend itself directly on your machine via `uvicorn`
# (see README Quick Start) — not inside Docker. `localhost` is correct for
# that setup, since a host process can't resolve Docker's internal service
# names like `db` or `redis` at all.
#
# ONLY if you instead run the `api`/`celery_worker`/`celery_beat` services
# themselves inside docker-compose (not the default/documented path), swap
# these to the service names and their INTERNAL port 5432/6379, e.g.:
#   DATABASE_URL=postgresql://kohwai:secret@db:5432/kohwai
#   REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://kohwai:secret@localhost:5434/kohwai
TIMESCALE_URL=postgresql://kohwai:secret@localhost:5435/kohwai_ts
POSTGRES_PASSWORD=secret

# ─── Redis / Celery ──────────────────────────────────────────────────────
# Host-exposed port 6380, not Redis's default 6379 — 6379 is commonly taken
# by a locally-installed Redis/Memurai service or another project. This is
# only the HOST-facing port; containers still talk to each other over the
# normal internal 6379 (see docker-compose.yml's api/celery `environment:`
# overrides, which are unaffected by this).
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1

