# Copy to .env at the repo root:  cp .env.example .env
# Secrets here are placeholders. NEVER commit a real .env.

# ─── Core ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to start outside development while this is the default.
SECRET_KEY=changeme
# Dev only: lets /auth/otp/request echo the OTP when no SMS gateway is set.
# Ignored unless ENVIRONMENT=development.
EXPOSE_DEV_OTP=true

# ─── Database (docker-compose service names; override for host runs, see README) ──
POSTGRES_PASSWORD=secret
DATABASE_URL=postgresql://kohwai:secret@db:5432/kohwai
TIMESCALE_URL=postgresql://kohwai:secret@timescaledb:5432/kohwai_ts

# ─── Redis / Celery ───────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── CORS (JSON list). Must include the web app's real dev origin. ────────
ALLOWED_ORIGINS=["http://localhost:3010","http://localhost:3000","http://localhost:8000"]

# ─── Africa's Talking — leave BLANK for local dev (a value enables real SMS) ──
AT_API_KEY=
AT_USERNAME=
AT_SHORTCODE=123

# ─── Not used yet (no live EcoCash integration) ───────────────────────────
ECOCASH_API_KEY=
ECOCASH_API_SECRET=

# ─── AWS / MLflow (only when training / shipping models) ──────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
S3_MODEL_BUCKET=kohwai-models
MLFLOW_TRACKING_URI=http://localhost:5050

# ─── Misc ─────────────────────────────────────────────────────────────────
SENTRY_DSN=
GRAFANA_PASSWORD=admin
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
