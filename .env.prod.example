# Non-secret production settings. Copy to .env.prod (gitignored) and edit.
# Secrets (passwords, keys) do NOT go here: run ./scripts/gen-secrets.sh and see docs/DEPLOYMENT.md.

# ── required ──
DOMAIN=kohwai.example.org            # DNS A/AAAA record must already point at this server
ACME_EMAIL=ops@example.org           # Let's Encrypt expiry notices

# ── image tag (use the git tag/commit you deployed, so you can roll back) ──
KOHWAI_VERSION=local

# ── Africa's Talking (the API key is the secret file ./secrets/AT_API_KEY) ──
AT_USERNAME=
AT_SHORTCODE=
USSD_SERVICE_CODE=                   # e.g. *123# — shown in alert SMS text
# Comma-separated source IPs Africa's Talking calls your USSD callback from (get them from their dashboard/support).
# EMPTY = all USSD traffic is rejected (fail closed).
USSD_ALLOWED_IPS=

# ── helplines shown to farmers (leave blank until Agritex / Vet Services confirm real numbers) ──
VET_SERVICES_CONTACT=
AGRITEX_CONTACT=

# ── consent text links + version (bump TERMS_VERSION when the legal text changes: everyone is asked to re-accept) ──
TERMS_URL=
PRIVACY_URL=
TERMS_VERSION=2026-11-draft

# ── optional ──
TILE_URL=                            # map tiles provider (openstreetmap.org's public servers are not for production traffic)
SENTRY_DSN=
WEB_CONCURRENCY=3
BACKUP_CRON=30 2 * * *
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MONTHS=6
# Off-site copy; receives the backup file path as $1, e.g.:  aws s3 cp "$1" s3://my-bucket/kohwai/
BACKUP_UPLOAD_CMD=
