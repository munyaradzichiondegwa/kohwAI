name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  backend:
    runs-on: ubuntu-latest
    env:
      ENVIRONMENT: development
      EXPOSE_DEV_OTP: "true"
      DATABASE_URL: postgresql://kohwai:secret@localhost:5432/kohwai_test
      REDIS_URL: redis://localhost:6379/0
      CELERY_BROKER_URL: redis://localhost:6379/0
      CELERY_RESULT_BACKEND: redis://localhost:6379/1
      SECRET_KEY: ci-only-secret
    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_USER: kohwai
          POSTGRES_PASSWORD: secret
          POSTGRES_DB: kohwai_test
        ports:
          - "5432:5432"
        options: >-
          --health-cmd "pg_isready -U kohwai"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10
      redis:
        image: redis:7
        ports:
          - "6379:6379"
    defaults:
      run:
        working-directory: backend
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: backend/requirements.txt

      - run: sudo apt-get update && sudo apt-get install -y libpq-dev age postgresql-client

      - run: pip install -r requirements.txt

      - name: Dependency sanity (catches kombu/redis style conflicts)
        run: pip check

      - run: python -m pytest -q

  web:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - run: npm ci --legacy-peer-deps

      - run: npx tsc --noEmit
        working-directory: apps/web

      - run: npm test --workspace=apps/web

      - run: npm run lint --workspace=apps/web

      - run: npm run build --workspace=apps/web

  # Runs the REAL web data layer against a REAL booted API
  # (offline queue, payload shapes, validation errors).
  contract:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_USER: kohwai
          POSTGRES_PASSWORD: secret
          POSTGRES_DB: kohwai
        ports:
          - "5432:5432"
        options: >-
          --health-cmd "pg_isready -U kohwai"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10
      redis:
        image: redis:7
        ports:
          - "6379:6379"
    env:
      ENVIRONMENT: development
      EXPOSE_DEV_OTP: "true"
      DATABASE_URL: postgresql://kohwai:secret@localhost:5432/kohwai
      REDIS_URL: redis://localhost:6379/0
      CELERY_BROKER_URL: redis://localhost:6379/0
      CELERY_RESULT_BACKEND: redis://localhost:6379/1
      SECRET_KEY: ci-only-secret
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: backend/requirements.txt

      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - run: sudo apt-get update && sudo apt-get install -y libpq-dev

      - run: pip install -r backend/requirements.txt

      - run: alembic upgrade head && python scripts/seed_admin.py 0779990055
        working-directory: backend

      - run: (uvicorn app.main:app --port 8000 &) && sleep 6 && curl -sf localhost:8000/health
        working-directory: backend

      - run: npm ci --legacy-peer-deps

      - run: npm test --workspace=apps/web
        env:
          KOHWAI_API_URL: "http://127.0.0.1:8000"
          ADMIN_PHONE: "0779990055"

  mobile:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - run: npm ci --legacy-peer-deps

      - run: npx tsc --noEmit
        working-directory: apps/mobile

  # Builds production images and validates the production compose file.
  docker:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - run: docker build -t kohwai/api:ci backend

      - run: docker build -t kohwai/web:ci -f apps/web/Dockerfile .

      - run: docker build -t kohwai/backup:ci infrastructure/backup

      - name: Validate docker-compose.prod.yml
        run: |
          cp .env.prod.example .env.prod
          sed -i 's/^DOMAIN=.*/DOMAIN=ci.example.org/; s/^ACME_EMAIL=.*/ACME_EMAIL=ci@example.org/' .env.prod
          sudo apt-get update && sudo apt-get install -y age
          ./scripts/gen-secrets.sh
          docker compose -f docker-compose.prod.yml --env-file .env.prod config --quiet

      - name: The API container refuses to start with the default secret
        run: |
          ! docker run --rm -e ENVIRONMENT=production -e SECRET_KEY=changeme kohwai/api:ci python -c "import asyncio,app.main as m; asyncio.run(m.lifespan(m.app).__aenter__())" 2>/tmp/err
          grep -q "Refusing to start" /tmp/err
